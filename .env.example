# Committed defaults, loaded automatically (lowest priority).
# Override locally in .env (gitignored); in production set real values in the host environment.
# Validated at build and startup by src/env.ts. Set SKIP_ENV_VALIDATION=1 to bypass.

DATABASE_URL="postgresql://my-app:my-app@localhost:5432/my-app?schema=public"

# Optional outside production (a dev-only default is used). Required in production.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated emails of the admins, applied once each address is verified.
# The app sends no email: mark an address verified manually in the database.
# The only source of the admin role; restart after changing it.
ADMIN_EMAILS=""

# Vercel AI Gateway. Claude Sonnet 5.5 writes the answers to questions and the drafted
# replies in the inbox; `pnpm db:seed` and `pnpm db:embed` use it too. Set it in .env.local;
# on Vercel the deployment's OIDC token works without it.
# Left commented here so this empty default never shadows the real key.
# https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys
# AI_GATEWAY_API_KEY=""
