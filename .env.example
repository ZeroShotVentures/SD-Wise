# Committed defaults, loaded automatically (lowest priority).
# Override locally in .env (gitignored); in production set real values in the host environment.
# Validated at build and startup by src/env.ts. Set SKIP_ENV_VALIDATION=1 to bypass.

DATABASE_URL="postgresql://my-app:my-app@localhost:5432/my-app?schema=public"

# Optional outside production (a dev-only default is used). Required in production.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated emails of the admins, applied once each address is verified.
# The only source of the admin role; restart after changing it.
ADMIN_EMAILS=""

# Sign in with Google. Enabled when both are set.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

AI_GATEWAY_API_KEY=vck_abc

# Transactional email (password reset, email verification) via Resend.
# Without an API key, emails are printed to the server console in development
# and email features are disabled in production.
# https://resend.com/api-keys
RESEND_API_KEY=""
# Must use a domain verified in Resend. onboarding@resend.dev only delivers to your own Resend account address.
EMAIL_FROM="my-app <onboarding@resend.dev>"
