generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean
  image            String?
  createdAt        DateTime
  updatedAt        DateTime
  role             String?
  banned           Boolean?  @default(false)
  banReason        String?
  banExpires       DateTime?

  sessions Session[]
  accounts Account[]

  personId String? @unique
  person   Person? @relation(fields: [personId], references: [id])

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

enum Department {
  HR
  IT
  FINANCE
  MARKETING
  SALES
  CUSTOMER_SERVICE
  PRODUCTION
  LOGISTICS
  MAINTENANCE
  SECURITY
  CLEANING
  SECRETARIAL
  RECEPTION
  ACCOUNTING
  AUDIT
  OTHER
}

/// graph schema

enum IntegrationType {
  slack
  email
  google_meet
}

enum KnowledgeSource {
  MESSAGE
  EMAIL
  MEETING
  DOCUMENT
  OTHER
}

model Integrations {
  id    String          @id @default(uuid())
  type  IntegrationType
  nodes KnowledgeNode[]
}

model Person {
  id         String          @id @default(uuid())
  // role in the company ()
  role       String
  department Department
  user       User?
  knowledge  KnowledgeNode[]
  asked      Question[]      @relation("QuestionAsker")
  received   Question[]      @relation("QuestionRecipient")
}

model KnowledgeNode {
  id                String          @id @default(uuid())
  content           String
  contentEmbedding  Unsupported("vector(1536)")?
  contentSummary    String
  access            Person[]
  source            KnowledgeSource
  integrationId     String
  integration       Integrations    @relation(fields: [integrationId], references: [id])
  sourceDescription String
  outgoingEdges     KnowledgeEdge[] @relation("EdgeSource")
  incomingEdges     KnowledgeEdge[] @relation("EdgeTarget")
  edgeCount         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  lastAccessedAt    DateTime        @default(now())

  @@index([integrationId])
  /// HNSW (vector_cosine_ops) index, created in the knowledge_node_embedding migration
  @@index([contentEmbedding])
}

model KnowledgeEdge {
  id       String        @id @default(uuid())
  sourceId String
  source   KnowledgeNode @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId String
  target   KnowledgeNode @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([targetId])
}

enum QuestionKind {
  QUESTION
  ACCESS
}

enum QuestionStatus {
  PENDING
  ANSWERED
  DECLINED
}

enum ShareScope {
  ASKER
  PUBLIC
}

/// A question (or access request) routed from one person to another.
model Question {
  id          String         @id @default(uuid())
  kind        QuestionKind
  askerId     String
  asker       Person         @relation("QuestionAsker", fields: [askerId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   Person         @relation("QuestionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  question    String
  /// QUESTION: nodes the search matched. ACCESS: the node being requested.
  /// No relation: the graph is still mocked, so these are fixture ids.
  nodeIds     String[]
  status      QuestionStatus @default(PENDING)
  answer      String?
  shareScope  ShareScope?
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?
  /// When the asker first looked at the answer or granted node.
  seenAt      DateTime?

  @@index([recipientId, status])
  @@index([askerId])
}
